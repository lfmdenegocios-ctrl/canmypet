# Internal working files (project rules, agent queues/calendars) are never public.
# Hostinger's git deploy does not delete files removed from the repo, so block by type.
<FilesMatch "\.(md|csv)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# CanMyPet — cache policy
<IfModule mod_headers.c>
  # HTML sempre revalida — nunca servir versão velha
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Assets (CSS/JS versionados por ?v=, imagens) — cache longo
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
